# ── Base de datos ────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── NextAuth ─────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=tu-secret-aqui
NEXTAUTH_URL=https://ventoo-calendar.vercel.app

# ── Google Gemini ─────────────────────────────────────
# Consíguelo en: https://aistudio.google.com/
GOOGLE_AI_API_KEY=tu-api-key-aqui

# ── Gmail SMTP ───────────────────────────────────────
# Activa "Contraseñas de aplicaciones" en tu cuenta Google
# https://myaccount.google.com/apppasswords
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Email de auditoría ───────────────────────────────
# Recibe las notificaciones de login/logout
AUDIT_EMAIL=admin@gmail.com

# ── Vercel Cron ──────────────────────────────────────
# Genera con: openssl rand -hex 32
CRON_SECRET=tu-cron-secret-aqui
